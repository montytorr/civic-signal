{
  "name": "civicsignal",
  "private": true,
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate --filter=@civicsignal/db",
    "db:generate": "turbo run db:generate --filter=@civicsignal/db"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "browserslist": "^4.28.7",
      "source-map-js": "^1.2.2"
    }
  },
  "license": "MPL-2.0"
}
